<!doctype html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SnapLam - Admin Panel</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body data-theme="<%= user.theme || 'abu' %>">
<div class="blob blob1"></div>
<div class="blob blob2"></div>
<div class="toast-stack" id="toastStack"></div>

<div class="app">
  <aside class="sidebar">
    <div class="sidebar-card">
      <div class="userchip">
        <div class="avatar"><%= user.username.charAt(0).toUpperCase() %></div>
        <div>
          <div style="font-weight:700;"><%= user.username %></div>
          <span class="role-badge admin">admin</span>
        </div>
      </div>
      <div style="margin-top:16px;">
        <div class="section-title" style="font-size:13px;"><span class="bar"></span>Tema</div>
        <div class="theme-row">
          <div class="theme-dot t-abu" data-theme="abu" title="Abu"></div>
          <div class="theme-dot t-biru" data-theme="biru" title="Biru"></div>
          <div class="theme-dot t-putih" data-theme="putih" title="Putih"></div>
          <div class="theme-dot t-orange" data-theme="orange" title="Orange"></div>
          <div class="theme-dot t-emas" data-theme="emas" title="Emas"></div>
        </div>
      </div>
      <a href="/dashboard"><button class="btn ghost" style="margin-top:16px;">⬅ Dashboard User</button></a>
      <a href="/logout"><button class="logout-btn" style="width:100%; margin-top:10px;">🚪 Keluar</button></a>
    </div>

    <div class="sidebar-card">
      <div class="section-title"><span class="bar"></span>Chat Room</div>
      <div class="chat-box">
        <div class="chat-msgs" id="chatMsgs"></div>
        <div class="chat-input-row">
          <input type="text" id="chatInput" placeholder="Ketik pesan..." maxlength="500">
          <button class="chat-send" id="chatSendBtn">Kirim</button>
        </div>
      </div>
    </div>
  </aside>

  <div class="main">
    <div class="topbar">
      <div>
        <h1 class="page-title">🛠 Panel Admin</h1>
        <div class="subtitle">Pantau semua aktivitas user secara realtime.</div>
      </div>
    </div>

    <div class="panel">
      <div class="section-title"><span class="bar"></span>Ringkasan</div>
      <div class="stat-grid">
        <div class="stat-card"><div class="stat-num"><%= users.length %></div><div class="stat-label">Total User</div></div>
        <div class="stat-card"><div class="stat-num"><%= logs.length %></div><div class="stat-label">Total Log Unduhan</div></div>
        <div class="stat-card"><div class="stat-num"><%= logs.filter(l => l.status === 'sukses').length %></div><div class="stat-label">Sukses</div></div>
        <div class="stat-card"><div class="stat-num"><%= logs.filter(l => l.status !== 'sukses').length %></div><div class="stat-label">Gagal / Error</div></div>
      </div>
    </div>

    <div class="panel">
      <div class="section-title"><span class="bar"></span>Broadcast Notifikasi</div>
      <form class="notif-form" id="notifForm">
        <input type="text" id="notifInput" placeholder="Tulis pesan notifikasi untuk semua user..." required>
        <button type="submit">Kirim</button>
      </form>
    </div>

    <div class="panel">
      <div class="section-title"><span class="bar"></span>Log Terminal Semua User (Realtime)</div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>User</th><th>Pesan</th><th>Level</th><th>Waktu</th></tr></thead>
          <tbody id="adminLogsBody">
            <tr><td colspan="4" class="empty-state">Menunggu aktivitas realtime...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="section-title"><span class="bar"></span>Riwayat Unduhan (Database)</div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>User</th><th>Platform</th><th>URL</th><th>Status</th><th>Waktu</th></tr></thead>
          <tbody>
            <% if (logs.length === 0) { %>
              <tr><td colspan="5" class="empty-state">Belum ada log.</td></tr>
            <% } %>
            <% logs.forEach(function(l) { %>
              <tr>
                <td><%= l.username %></td>
                <td><%= l.platform || '-' %></td>
                <td class="mono" style="max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= l.url %></td>
                <td><span class="badge <%= l.status === 'sukses' ? 'sukses' : 'gagal' %>"><%= l.status %></span></td>
                <td><%= l.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="section-title"><span class="bar"></span>Daftar User</div>
      <div class="tbl-wrap">
        <table class="hist">
          <thead><tr><th>ID</th><th>Username</th><th>Role</th><th>Tema</th><th>Terdaftar</th></tr></thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.username %></td>
                <td><span class="badge <%= u.role === 'admin' ? 'sukses' : 'gagal' %>"><%= u.role %></span></td>
                <td><%= u.theme %></td>
                <td><%= u.created_at %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <%- include('partials/footer') %>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/theme.js"></script>
<script src="/js/chat.js"></script>
<script src="/js/admin.js"></script>
<script>SnapLamTheme.init('<%= user.theme || "abu" %>');</script>
</body>
</html>
